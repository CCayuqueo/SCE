# Configuración local. Genera una contraseña propia antes de iniciar Compose.
# Usa caracteres hexadecimales para poder incluirla en una URL sin codificación.
POSTGRES_USER=src
POSTGRES_DB=src
POSTGRES_PASSWORD=
SRC_HTTP_PORT=3000
APP_ENV=development
APP_ORIGIN=http://localhost:3000
SESSION_TTL_HOURS=24
SESSION_IDLE_MINUTES=60
MAX_ROOM_MEMBERS=100

MAX_UPLOAD_MB=5
MAX_IMAGE_PIXELS=12000000
IMAGE_PROCESSING_TIMEOUT_SECONDS=15
IMAGE_PROCESSING_CONCURRENCY=2

# Valores previstos para fases posteriores.
APP_PORT=8000
ROOM_CODE_LENGTH=12
